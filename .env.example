# Copy this file to `.env` and fill in the values you need.
# Only the provider you choose has to be configured.

# ---- Provider selection --------------------------------------------------
# One of: gemini | deepseek | openai | ollama | fake
# `fake` uses a scripted, deterministic in-memory model — perfect for tests
# and for poking at the graph without burning API credit.
CODING_AGENT_PROVIDER=gemini

# ---- Google Gemini -------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- DeepSeek ------------------------------------------------------------
# Get a key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Base URL is OpenAI-compatible; rarely needs changing.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- OpenAI --------------------------------------------------------------
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: override the API base (e.g. for Azure or a compatible proxy).
# Leave blank to use OpenAI's default.
OPENAI_BASE_URL=

# ---- Ollama (local open-weights, no key) ----------------------------------
# Needs the optional extra:  pip install -e '.[ollama]'
# and a running server:      ollama serve   +   ollama pull qwen3.5:9b
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_BASE_URL=http://localhost:11434
# Context window in tokens. Ollama's default is small and SILENTLY
# truncates longer prompts, so we always pass this explicitly.
OLLAMA_NUM_CTX=16384

# ---- Agent loop limits ---------------------------------------------------
# Hard cap on iterations of the observe -> choose -> act loop.
CODING_AGENT_MAX_ITERATIONS=12
# Tool output is clipped to this many characters before being fed back in.
CODING_AGENT_TOOL_OUTPUT_LIMIT=4000
# Transcript is compressed once it grows past this many entries.
CODING_AGENT_TRANSCRIPT_COMPRESS_AT=20

# ---- Tracing -------------------------------------------------------------
# Directory where JSONL traces are written.
CODING_AGENT_TRACE_DIR=traces
# Set to "0" to silence the pretty stdout trace (JSONL still written).
CODING_AGENT_TRACE_STDOUT=1
